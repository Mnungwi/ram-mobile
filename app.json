{
  "expo": {
    "name": "United Ram Mobile",
    "slug": "pms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unitedram.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This application uses your GPS location to track project site distance and enable geofencing check-ins.",
        "NSFaceIDUsageDescription": "This application uses FaceID to authenticate you securely into the dashboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.unitedram.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow United Ram Mobile to use Face ID for passwordless authentication."
        }
      ]
    ],
    "scheme": "ram-mobile",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4a0bfdd7-a862-4cdb-a023-248da20b65f2"
      }
    },
    "owner": "mnungwi"
  }
}
